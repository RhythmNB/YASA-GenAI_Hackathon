# NWS requires a User-Agent naming your app and a contact email
NWS_USER_AGENT=visit-planner-hackathon/0.1 (your-email@example.com)

# Local Postgres that Zetaris reads from
POSTGRES_USER=weather
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=weather

# "sample" reads sample_data/weather_sample.db, "zetaris" queries through Zetaris
WEATHER_MODE=sample
SAMPLE_DB=sample_data/weather_sample.db

# Zetaris JDBC (default port 10000)
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_USER=admin@zetaris.com
ZETARIS_PASSWORD=your-zetaris-password
ZETARIS_JDBC_JAR=../zetaris-platform/jdbc/ndp-jdbc-driver-2.4.3.1-7eff043-driver.jar

# Table names exactly as they appear in the Zetaris SQL Editor
ZETARIS_FORECAST_TABLE=weather_pg.forecast_periods
ZETARIS_ALERTS_TABLE=weather_pg.weather_alerts

# Model provider: "sample" runs with no model (judges), "nightshift" calls Meterless Nightshift
LLM_MODE=sample
# Nightshift endpoint (OpenAI-compatible)
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
# Optional: leave as-is on Windows, the token is read from Nightshift's own file
NIGHTSHIFT_API_KEY=
# A model named directly (the meterless/* aliases are not used)
NIGHTSHIFT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional app name sent as the meterless-app header
NIGHTSHIFT_APP=visit-planner

# Live refresh: if a city's data is older than this (hours), the agent re-downloads that city
# from NWS before answering. Set WEATHER_AUTO_REFRESH=0 to turn it off.
WEATHER_AUTO_REFRESH=1
WEATHER_MAX_AGE_HOURS=1
# 1 = also update Postgres during live refresh (machine running Zetaris); 0 = laptops without Docker
WEATHER_REFRESH_POSTGRES=1
