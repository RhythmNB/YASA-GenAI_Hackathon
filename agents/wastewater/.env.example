# Copy to .env (next to this file). All optional; defaults shown.
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
# Either a literal token or a file holding it. The file default is the
# Meterless runtime's proxy-token under %LOCALAPPDATA%\ai.meterless.runtime.
#NIGHTSHIFT_TOKEN=
#NIGHTSHIFT_TOKEN_FILE=C:\Users\you\AppData\Local\ai.meterless.runtime\proxy-token
# Routes tried in order; a route that errors is skipped for five minutes and
# the next one answers. Only when every route fails do the offline templates
# write the answer (shown with an [offline] prefix).
#NIGHTSHIFT_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-lightning-30b-a3b
# install.py fills these in. Zetaris credentials are read from the getting-started
# checkout's .env.local (default: getting-started next to this repository).
#ZETARIS_ENV_FILE=/path/to/getting-started/.env.local
# JDK used by the JDBC driver when JAVA_HOME is not set, and the driver jar.
#JAVA_HOME_DEFAULT=/path/to/jdk
#ZETARIS_JDBC_JAR=/path/to/zetaris-platform/jdbc/ndp-jdbc-driver-2.4.3.1-7eff043-driver.jar
