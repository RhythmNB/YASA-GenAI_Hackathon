# Copy these into getting-started/.env.local (next to the Zetaris settings). Never commit real keys.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_USERNAME=admin@zetaris.com
ZETARIS_PASSWORD=
ZETARIS_REST_URL=http://localhost:8888/api/v1.0

# Meterless Nightshift (runs on your own Mac; key from Nightshift > Console (Cmd+5) > Connect)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_API_KEY=
# Local WebLLM models failed to load through the API on Sandeep's Mac; NVIDIA via Nightshift works.
# Add an NVIDIA key (build.nvidia.com) in Nightshift > Setup > Providers first.
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_APP=visit-planner-cloud
METERLESS_REASONING_EFFORT=low
METERLESS_TTFB_MS=300000
METERLESS_MAX_TOKENS=2000
# Optional: a different model for the reviewer
METERLESS_EVAL_MODEL=
