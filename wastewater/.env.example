# Copy to .env (next to this file). All optional; defaults shown.
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
# Either a literal token or a file holding it. The file default is the
# Meterless runtime's proxy-token under %LOCALAPPDATA%\ai.meterless.runtime.
#NIGHTSHIFT_TOKEN=
#NIGHTSHIFT_TOKEN_FILE=C:\Users\you\AppData\Local\ai.meterless.runtime\proxy-token
# Zetaris credentials are read from the getting-started checkout.
ZETARIS_ENV_FILE=F:\Hackathon\getting-started\.env.local
# JDK used by the JDBC driver when JAVA_HOME is not set.
JAVA_HOME_DEFAULT=F:\jdk-23.0.2
